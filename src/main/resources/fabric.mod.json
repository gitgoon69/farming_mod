{
	"schemaVersion": 1,
	"id": "fermento",
	"version": "${version}",
	"name": "Fermento",
	"description": "Garden coins/hour, pests, and Bazaar prices for Hypixel SkyBlock. Named after the endgame farming set.",
	"icon": "assets/fermento/icon.png",
	"authors": [
		"matte"
	],
	"contact": {
		"homepage": "https://github.com/matteorlt/farming_mod",
		"sources": "https://github.com/matteorlt/farming_mod",
		"issues": "https://github.com/matteorlt/farming_mod/issues"
	},
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"main": [
			"dev.fermento.FermentoMod"
		],
		"client": [
			"dev.fermento.client.FermentoClient"
		]
	},
	"mixins": [
		"fermento.client.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.1",
		"minecraft": "${minecraft}",
		"java": ">=25",
		"fabric-api": "*"
	}
}
