{
	"schemaVersion": 1,
	"id": "farmingprofit",
	"version": "${version}",
	"name": "Farming Profit",
	"description": "Tracks coins/hour while farming crops on Hypixel SkyBlock Garden, using Cofl Bazaar prices (enchanted / 160).",
	"authors": [
		"matte"
	],
	"contact": {
		"homepage": "https://github.com/matteorlt/farming_mod",
		"sources": "https://github.com/matteorlt/farming_mod",
		"issues": "https://github.com/matteorlt/farming_mod/issues"
	},
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"main": [
			"dev.farmingprofit.FarmingProfitMod"
		],
		"client": [
			"dev.farmingprofit.client.FarmingProfitClient"
		]
	},
	"mixins": [
		"farmingprofit.client.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.1",
		"minecraft": "${minecraft}",
		"java": ">=25",
		"fabric-api": "*"
	}
}
