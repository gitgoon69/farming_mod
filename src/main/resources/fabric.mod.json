{
	"schemaVersion": 1,
	"id": "stook",
	"version": "${version}",
	"name": "Stook",
	"description": "Garden coins/hour, pests, and Bazaar prices for SkyBlock.",
	"icon": "assets/stook/icon.png",
	"authors": [
		"matte"
	],
	"contact": {
		"homepage": "https://github.com/matteorlt/farming_mod",
		"sources": "https://github.com/matteorlt/farming_mod",
		"issues": "https://github.com/matteorlt/farming_mod/issues"
	},
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"main": [
			"dev.stook.StookMod"
		],
		"client": [
			"dev.stook.client.StookClient"
		]
	},
	"mixins": [
		"stook.client.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.1",
		"minecraft": "${minecraft}",
		"java": ">=25",
		"fabric-api": "*"
